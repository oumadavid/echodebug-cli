# Production webhook URL from your own n8n EchoDebug workflow.
# Copy this file to .env locally if you want, or export the variable in your shell.
# You can also save it with `echorun --setup` (~/.echodebugrc) or pass --webhook.

ECHODEBUG_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/debug
